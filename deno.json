{
  "version": "0.5.3",
  "license": "AGPL-3.0-or-later",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite",
    "serve": "deno task build && vite preview",
    "demo": "vite --mode demo",
    "diagnostics": "vite --mode diagnostics",
    "benchmark": "vite --mode benchmark",
    "check": "deno task check:app && deno task check:node",
    "check:app": "deno check src-env.d.ts shared send receive home tests",
    "check:node": "deno check build vite.config.ts",
    "build": "deno task check && vite build",
    "build:standalone": "rm -rf dist-standalone && deno task check:app && vite build --mode standalone-send && vite build --mode standalone-receive",
    "build:all": "deno task build && deno task build:standalone",
    "preview": "vite preview",
    "icons": "deno run --allow-read --allow-write --allow-run build/make-icons.ts",
    "benchmark:promote": "deno run --allow-read --allow-write build/benchmarks.ts promote",
    "benchmark:readme": "deno run --allow-read --allow-write build/benchmarks.ts readme",
    "test": "deno test --allow-read"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/bytes": "jsr:@std/bytes@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@types/node": "npm:@types/node@^26.1.2",
    "@vitejs/plugin-basic-ssl": "npm:@vitejs/plugin-basic-ssl@^1.2.0",
    "qrcode": "npm:qrcode@^1.5.4",
    "vite": "npm:vite@^6.0.0",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@^1.3.0",
    "vite-plugin-singlefile": "npm:vite-plugin-singlefile@^2.3.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  "exclude": ["dist", "dist-standalone", "artifacts", "scratch"]
}
